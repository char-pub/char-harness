    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./app": {
      "types": "./lib/types/app.d.ts",
      "default": "./lib/app.js"
    },
    "./app.patch.yml": "./app.patch.yml",
    "./app-types": {
      "types": "./lib/types/app-types.d.ts"
    }
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/app.js",
    "app.patch.yml",
    "lib/preview-export-*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@char-pub/core": "file:../../../third_party/charpub/snapshots/story-v1-7d17291cbad10ff7/tarballs/char-pub-core-0.0.0.tgz",
    "@char-pub/assembler": "file:../../../third_party/charpub/snapshots/story-v1-7d17291cbad10ff7/tarballs/char-pub-assembler-0.0.0.tgz",
    "@deepseek-ai/dsh-experimental-charpub-roleplay": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.6.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@char-pub/contracts": "file:../../../third_party/charpub/snapshots/story-v1-7d17291cbad10ff7/tarballs/char-pub-contracts-0.0.0.tgz",
    "oauth4webapi": "3.8.8",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "workspace:*",
    "@deepseek-ai/dsh-charpub-roleplay-web": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*"
